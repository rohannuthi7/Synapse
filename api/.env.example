# Read by app/main.py at startup. None are required for local development.

# Web origins allowed to call the API, comma-separated. A deploy sets this to
# the site's public URL, e.g. https://synapse.example.com.
SYNAPSE_CORS_ORIGINS=http://localhost:5173

# Git commit of the running build, shown in the web footer. Set it from the
# deploy, e.g. SYNAPSE_COMMIT=$(git rev-parse --short HEAD).
SYNAPSE_COMMIT=

# Who scores the 8x8 frame: auto, fpga or emulated. auto uses the board when
# SYNAPSE_SERIAL_PORT is set and opens, and the Python emulator otherwise.
# fpga never falls back, so a missing board is an error instead of a guess.
SYNAPSE_BOARD=auto

# The USB-UART adapter's port: COM5 on Windows (Device Manager > Ports),
# /dev/ttyUSB0 on Linux, /dev/tty.usbserial-* on macOS.
SYNAPSE_SERIAL_PORT=
