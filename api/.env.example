# Read by app/main.py at startup. None are required for local development.

# Web origins allowed to call the API, comma-separated. A deploy sets this to
# the site's public URL, e.g. https://synapse.example.com.
SYNAPSE_CORS_ORIGINS=http://localhost:5173

# Git commit of the running build, shown in the web footer. Set it from the
# deploy, e.g. SYNAPSE_COMMIT=$(git rev-parse --short HEAD).
SYNAPSE_COMMIT=
