# Where the web app sends requests. A deploy sets this to the API's public URL,
# and the API must list the site's origin in SYNAPSE_CORS_ORIGINS.
VITE_API_URL=http://localhost:8000

# The site's own public URL, no trailing slash. Only used to make the link
# preview (og:image) absolute; leave empty for local development.
VITE_SITE_URL=
